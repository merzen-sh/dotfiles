{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "d_bg": "{{colors.background.dark.hex}}",
    "d_surface": "{{colors.surface_container.dark.hex}}",
    "d_surface2": "{{colors.surface_container_high.dark.hex}}",
    "d_surface3": "{{colors.surface_container_highest.dark.hex}}",
    "d_surface4": "{{colors.surface_bright.dark.hex}}",
    "d_fg": "{{colors.on_surface.dark.hex}}",
    "d_fg1": "{{colors.on_surface_variant.dark.hex}}",
    "d_muted": "{{colors.outline.dark.hex}}",
    "d_primary": "{{colors.primary.dark.hex}}",
    "d_primary_c": "{{colors.primary_container.dark.hex}}",
    "d_secondary": "{{colors.secondary.dark.hex}}",
    "d_tertiary": "{{colors.tertiary.dark.hex}}",
    "d_error": "{{colors.error.dark.hex}}",
    "l_bg": "{{colors.background.light.hex}}",
    "l_surface": "{{colors.surface_container.light.hex}}",
    "l_surface2": "{{colors.surface_container_high.light.hex}}",
    "l_surface3": "{{colors.surface_container_highest.light.hex}}",
    "l_fg": "{{colors.on_surface.light.hex}}",
    "l_fg1": "{{colors.on_surface_variant.light.hex}}",
    "l_muted": "{{colors.outline.light.hex}}",
    "l_primary": "{{colors.primary.light.hex}}",
    "l_primary_c": "{{colors.primary_container.light.hex}}",
    "l_secondary": "{{colors.secondary.light.hex}}",
    "l_tertiary": "{{colors.tertiary.light.hex}}",
    "l_error": "{{colors.error.light.hex}}"
  },
  "theme": {
    "primary": { "dark": "d_primary", "light": "l_primary" },
    "secondary": { "dark": "d_secondary", "light": "l_secondary" },
    "accent": { "dark": "d_primary", "light": "l_primary" },
    "error": { "dark": "d_error", "light": "l_error" },
    "warning": { "dark": "d_tertiary", "light": "l_tertiary" },
    "success": { "dark": "d_secondary", "light": "l_secondary" },
    "info": { "dark": "d_secondary", "light": "l_secondary" },
    "text": { "dark": "d_fg", "light": "l_fg" },
    "textMuted": { "dark": "d_muted", "light": "l_muted" },
    "background": { "dark": "d_bg", "light": "l_bg" },
    "backgroundPanel": { "dark": "d_surface", "light": "l_surface" },
    "backgroundElement": { "dark": "d_surface2", "light": "l_surface" },
    "border": { "dark": "d_surface3", "light": "l_muted" },
    "borderActive": { "dark": "d_muted", "light": "l_fg" },
    "borderSubtle": { "dark": "d_surface2", "light": "l_surface" },
    "diffAdded": { "dark": "d_secondary", "light": "l_secondary" },
    "diffRemoved": { "dark": "d_error", "light": "l_error" },
    "diffContext": { "dark": "d_muted", "light": "l_muted" },
    "diffHunkHeader": { "dark": "d_surface4", "light": "l_muted" },
    "diffHighlightAdded": { "dark": "d_tertiary", "light": "l_tertiary" },
    "diffHighlightRemoved": { "dark": "d_error", "light": "l_error" },
    "diffAddedBg": { "dark": "d_surface", "light": "l_surface" },
    "diffRemovedBg": { "dark": "d_surface", "light": "l_surface" },
    "diffContextBg": { "dark": "d_surface", "light": "l_surface" },
    "diffLineNumber": { "dark": "d_surface4", "light": "l_muted" },
    "diffAddedLineNumberBg": { "dark": "d_surface", "light": "l_surface" },
    "diffRemovedLineNumberBg": { "dark": "d_surface", "light": "l_surface" },
    "markdownText": { "dark": "d_fg", "light": "l_fg" },
    "markdownHeading": { "dark": "d_primary", "light": "l_primary" },
    "markdownLink": { "dark": "d_secondary", "light": "l_secondary" },
    "markdownLinkText": { "dark": "d_primary", "light": "l_primary" },
    "markdownCode": { "dark": "d_secondary", "light": "l_secondary" },
    "markdownBlockQuote": { "dark": "d_muted", "light": "l_muted" },
    "markdownEmph": { "dark": "d_tertiary", "light": "l_tertiary" },
    "markdownStrong": { "dark": "d_primary", "light": "l_primary" },
    "markdownHorizontalRule": { "dark": "d_surface3", "light": "l_muted" },
    "markdownListItem": { "dark": "d_primary", "light": "l_primary" },
    "markdownListEnumeration": { "dark": "d_secondary", "light": "l_secondary" },
    "markdownImage": { "dark": "d_secondary", "light": "l_secondary" },
    "markdownImageText": { "dark": "d_primary", "light": "l_primary" },
    "markdownCodeBlock": { "dark": "d_fg1", "light": "l_fg" },
    "syntaxComment": { "dark": "d_muted", "light": "l_muted" },
    "syntaxKeyword": { "dark": "d_primary", "light": "l_primary" },
    "syntaxFunction": { "dark": "d_primary", "light": "l_primary" },
    "syntaxVariable": { "dark": "d_fg", "light": "l_fg" },
    "syntaxString": { "dark": "d_secondary", "light": "l_secondary" },
    "syntaxNumber": { "dark": "d_tertiary", "light": "l_tertiary" },
    "syntaxType": { "dark": "d_secondary", "light": "l_secondary" },
    "syntaxOperator": { "dark": "d_primary", "light": "l_primary" },
    "syntaxPunctuation": { "dark": "d_muted", "light": "l_muted" }
  }
}
