#!/usr/bin/env bash

set -Eeuo pipefail

# =============================================================================
# Configuration
# =============================================================================

readonly REPO="equalsraf/win32yank"
readonly INSTALL_DIR="/usr/local/bin"
readonly BINARY_NAME="win32yank.exe"
readonly INSTALL_PATH="${INSTALL_DIR}/${BINARY_NAME}"

# =============================================================================
# Logging
# =============================================================================

log() {
    printf '[INFO] %s\n' "$1"
}

success() {
    printf '[ OK ] %s\n' "$1"
}

warn() {
    printf '[WARN] %s\n' "$1" >&2
}

error() {
    printf '[ERROR] %s\n' "$1" >&2
}

# =============================================================================
# Error Handling
# =============================================================================

cleanup() {
    if [[ -n "${TEMP_DIR:-}" && -d "${TEMP_DIR:-}" ]]; then
        rm -rf "$TEMP_DIR"
    fi
}

on_error() {
    local exit_code=$?
    error "Installation failed at line ${BASH_LINENO[0]}."
    exit "$exit_code"
}

trap cleanup EXIT
trap on_error ERR

# =============================================================================
# WSL Detection
# =============================================================================

is_wsl() {
    if [[ -n "${WSL_INTEROP:-}" ]]; then
        return 0
    fi

    if [[ -r /proc/version ]] &&
        grep -qiE 'microsoft|wsl' /proc/version; then
        return 0
    fi

    return 1
}

if ! is_wsl; then
    log "Not running inside WSL. Nothing to do."
    exit 0
fi

log "WSL environment detected."

# =============================================================================
# Check Existing Installation
# =============================================================================

if command -v "$BINARY_NAME" >/dev/null 2>&1; then
    EXISTING_PATH="$(command -v "$BINARY_NAME")"

    success "${BINARY_NAME} is already installed."
    log "Path: ${EXISTING_PATH}"

    exit 0
fi

# =============================================================================
# Dependencies
# =============================================================================

require_command() {
    local command_name="$1"

    if ! command -v "$command_name" >/dev/null 2>&1; then
        error "Required command not found: ${command_name}"
        exit 1
    fi
}

require_command curl
require_command unzip
require_command python3
require_command sudo

# =============================================================================
# Sudo
# =============================================================================

log "Checking sudo access..."

sudo -v

success "sudo access confirmed."

# =============================================================================
# Temporary Directory
# =============================================================================

TEMP_DIR="$(mktemp -d)"

ZIP_PATH="${TEMP_DIR}/win32yank.zip"
EXTRACT_DIR="${TEMP_DIR}/extract"

mkdir -p "$EXTRACT_DIR"

# =============================================================================
# Fetch Latest Release
# =============================================================================

API_URL="https://api.github.com/repos/${REPO}/releases/latest"

log "Fetching latest win32yank release..."

DOWNLOAD_URL="$(
    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 3 \
        --retry-delay 2 \
        --connect-timeout 10 \
        --max-time 60 \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "$API_URL" \
    | python3 -c '
import json
import sys

data = json.load(sys.stdin)

for asset in data.get("assets", []):
    name = asset.get("name", "")
    url = asset.get("browser_download_url", "")

    if name.endswith("x64.zip"):
        print(url)
        break
'
)"

if [[ -z "$DOWNLOAD_URL" ]]; then
    error "Could not find x64.zip in the latest GitHub release."
    exit 1
fi

log "Release URL found."

# =============================================================================
# Download
# =============================================================================

log "Downloading ${BINARY_NAME}..."

curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --retry 3 \
    --retry-delay 2 \
    --connect-timeout 10 \
    --max-time 120 \
    "$DOWNLOAD_URL" \
    --output "$ZIP_PATH"

if [[ ! -s "$ZIP_PATH" ]]; then
    error "Downloaded archive is empty or missing."
    exit 1
fi

success "Download completed."

# =============================================================================
# Extract
# =============================================================================

log "Extracting archive..."

unzip \
    -q \
    "$ZIP_PATH" \
    -d "$EXTRACT_DIR"

EXTRACTED_BINARY="$(
    find "$EXTRACT_DIR" \
        -type f \
        -name "$BINARY_NAME" \
        -print \
        -quit
)"

if [[ -z "$EXTRACTED_BINARY" ]]; then
    error "Could not find ${BINARY_NAME} inside the archive."
    exit 1
fi

success "Binary extracted."

# =============================================================================
# Install
# =============================================================================

log "Installing ${BINARY_NAME}..."

sudo install \
    -d \
    -m 755 \
    "$INSTALL_DIR"

sudo install \
    -m 755 \
    "$EXTRACTED_BINARY" \
    "$INSTALL_PATH"

# =============================================================================
# Verify
# =============================================================================

if [[ ! -x "$INSTALL_PATH" ]]; then
    error "Installation completed but binary is not executable."
    exit 1
fi

success "${BINARY_NAME} installed successfully."

log "Path: ${INSTALL_PATH}"

# =============================================================================
# Complete
# =============================================================================

echo
log "WSL clipboard support is ready."
