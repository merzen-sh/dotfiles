#!/usr/bin/env -S uv run --script

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path


# =============================================================================
# CONSTANTS
# =============================================================================

BACKUP_DIR_NAME = ".dotfiles-backups"

# =============================================================================
# ENVIRONMENT
# =============================================================================

def is_wsl_environment() -> bool:
    """Return True when running inside WSL."""
    proc_version = Path("/proc/version")

    if not proc_version.exists():
        return False

    try:
        return "microsoft" in proc_version.read_text(
            encoding="utf-8",
            errors="ignore",
        ).lower()
    except OSError:
        return False


IS_WSL_ENVIRONMENT = is_wsl_environment()

ACTIVE_DESKTOP_ENV = os.environ.get(
    "DOTFILES_DESKTOP",
    os.environ.get("XDG_CURRENT_DESKTOP", ""),
).lower().strip()

DOTFILES_DIR_PATH = Path(
    os.environ.get("DOTFILES_DIR", Path.cwd())
).expanduser().resolve()

USER_HOME_DIR = Path.home()


# =============================================================================
# DATA MODELS
# =============================================================================

@dataclass(frozen=True)
class SymlinkTarget:
    """Description of a dotfiles symlink target."""

    source_relative_path: str
    target_absolute_path: Path
    is_gui_only: bool = False
    requires_sudo: bool = False


@dataclass
class RuntimeOptions:
    """CLI/runtime configuration."""

    dry_run: bool = False
    verbose: bool = False
    backup: bool = True


