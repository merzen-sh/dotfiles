#!/usr/bin/env -S uv run --script

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Literal


# =============================================================================
# CONSTANTS / ENVIRONMENT
# =============================================================================

BACKUP_DIR_NAME = ".dotfiles-backups"


def is_wsl_environment() -> bool:
    if os.environ.get("WSL_INTEROP"):
        return True

    for proc_file in (Path("/proc/sys/kernel/osrelease"), Path("/proc/version")):
        try:
            contents = proc_file.read_text(encoding="utf-8", errors="ignore").lower()
        except OSError:
            continue

        if "microsoft" in contents or "wsl" in contents:
            return True

    return False


IS_WSL_ENVIRONMENT = is_wsl_environment()
ACTIVE_DESKTOP_ENV = (
    os.environ.get("DOTFILES_DESKTOP")
    or os.environ.get("XDG_CURRENT_DESKTOP")
    or os.environ.get("XDG_SESSION_DESKTOP")
    or ""
).split(":", maxsplit=1)[0].strip().lower()
DOTFILES_DIR_PATH = Path(os.environ.get("DOTFILES_DIR", Path.cwd())).expanduser().resolve()
USER_HOME_DIR = Path.home()


# =============================================================================
# CONFIGURATION
# =============================================================================

@dataclass(frozen=True)
class SymlinkTarget:
    source_relative_path: str
    target_absolute_path: Path
    is_gui_only: bool = False
    requires_sudo: bool = False


@dataclass(frozen=True)
class RuntimeOptions:
    dry_run: bool = False
    verbose: bool = False
    backup: bool = True


MappingResult = Literal["success", "skipped", "failed"]

USER_CONFIG_MAPPINGS = [
    # Shell / CLI
    SymlinkTarget(".tmux.conf", USER_HOME_DIR / ".tmux.conf"),
    SymlinkTarget(".vimrc", USER_HOME_DIR / ".vimrc"),
    SymlinkTarget("starship.toml", USER_HOME_DIR / ".config" / "starship.toml"),
    SymlinkTarget("fish", USER_HOME_DIR / ".config" / "fish"),
    SymlinkTarget("fastfetch", USER_HOME_DIR / ".config" / "fastfetch"),
    SymlinkTarget("nvim", USER_HOME_DIR / ".config" / "nvim"),
    SymlinkTarget("fzf", USER_HOME_DIR / ".config" / "fzf"),
    # GUI
    SymlinkTarget("ghostty", USER_HOME_DIR / ".config" / "ghostty", is_gui_only=True),
    SymlinkTarget("kitty", USER_HOME_DIR / ".config" / "kitty", is_gui_only=True),
    SymlinkTarget(
        "noctalia",
        USER_HOME_DIR / ".local" / "state" / "noctalia",
        is_gui_only=True,
    ),
]

DESKTOP_CONFIG_NAMES = {
    "hyprland": "hypr",
    "niri": "niri",
}

SYSTEM_CONFIG_MAPPINGS = [
    SymlinkTarget(
        "etc/keyd/default.conf",
        Path("/etc/keyd/default.conf"),
        is_gui_only=True,
        requires_sudo=True,
    ),
]


# =============================================================================
# LOGGING
# =============================================================================

class Logger:
    def __init__(self, verbose: bool = False) -> None:
        self.verbose_enabled = verbose

    @staticmethod
    def info(message: str) -> None:
        print(f"[INFO] {message}")

    @staticmethod
    def success(message: str) -> None:
        print(f"[ OK ] {message}")

    @staticmethod
    def warning(message: str) -> None:
        print(f"[WARN] {message}", file=sys.stderr)

    @staticmethod
    def error(message: str) -> None:
        print(f"[ERROR] {message}", file=sys.stderr)

    def debug(self, message: str) -> None:
        if self.verbose_enabled:
            print(f"[DEBUG] {message}")


# =============================================================================
# FILESYSTEM HELPERS
# =============================================================================

def path_exists(path: Path) -> bool:
    """Path.exists() also returns True for dangling symlinks."""
    return path.exists() or path.is_symlink()


def paths_are_same_symlink(target: Path, source: Path) -> bool:
    if not target.is_symlink():
        return False

    try:
        return target.resolve() == source.resolve()
    except OSError:
        return False


def run_sudo(command: list[str], options: RuntimeOptions, logger: Logger) -> None:
    logger.debug("sudo " + " ".join(command))
    if not options.dry_run:
        subprocess.run(["sudo", *command], check=True)


def ensure_parent_directory(
    target: Path,
    *,
    requires_sudo: bool,
    options: RuntimeOptions,
    logger: Logger,
) -> None:
    parent = target.parent

    if requires_sudo:
        run_sudo(["mkdir", "-p", "--", str(parent)], options, logger)
        return

    if parent.exists():
        if not parent.is_dir():
            raise RuntimeError(f"Target parent is not a directory: {parent}")
        return

    logger.debug(f"Creating directory: {parent}")
    if not options.dry_run:
        parent.mkdir(parents=True, exist_ok=True)


def remove_path(path: Path, options: RuntimeOptions, logger: Logger) -> None:
    if not path_exists(path):
        return

    kind = "symlink" if path.is_symlink() else "directory" if path.is_dir() else "file"
    logger.info(f"Remove: {path} ({kind})")

    if options.dry_run:
        return

    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)
    else:
        raise RuntimeError(f"Unsupported filesystem object: {path}")


# =============================================================================
# BACKUP / RESTORE
# =============================================================================

def backup_existing_target(
    target: Path,
    backup_root: Path,
    *,
    requires_sudo: bool,
    options: RuntimeOptions,
    logger: Logger,
    reserved_paths: set[Path],
) -> Path:
    """Move an existing target into a timestamped backup directory."""
    backup_dir = backup_root / "system" if requires_sudo else backup_root

    if not options.dry_run:
        backup_dir.mkdir(parents=True, exist_ok=True)

    backup_path = backup_dir / target.name
    suffix = 1

    while path_exists(backup_path) or backup_path in reserved_paths:
        backup_path = backup_dir / f"{target.name}.{suffix}"
        suffix += 1

    reserved_paths.add(backup_path)
    logger.info(f"Backup: {target} -> {backup_path}")

    if not options.dry_run:
        if requires_sudo:
            run_sudo(["mv", "--", str(target), str(backup_path)], options, logger)
        else:
            shutil.move(str(target), str(backup_path))

    return backup_path


def restore_backup(
    backup_path: Path | None,
    target: Path,
    *,
    requires_sudo: bool,
    options: RuntimeOptions,
    logger: Logger,
) -> None:
    """Attempt to restore the original target if symlink creation fails."""
    if backup_path is None or options.dry_run:
        return
    if not path_exists(backup_path) or path_exists(target):
        return

    logger.warning(f"Restoring backup: {backup_path} -> {target}")

    try:
        if requires_sudo:
            run_sudo(["mv", "--", str(backup_path), str(target)], options, logger)
        else:
            shutil.move(str(backup_path), str(target))
    except Exception as exc:
        logger.error(f"Could not restore backup for {target}: {exc}")


# =============================================================================
# SYMLINK PROCESSING
# =============================================================================

def process_symlink(
    source: Path,
    target: Path,
    backup_root: Path | None,
    reserved_backups: set[Path],
    *,
    requires_sudo: bool,
    options: RuntimeOptions,
    logger: Logger,
) -> None:
    ensure_parent_directory(
        target,
        requires_sudo=requires_sudo,
        options=options,
        logger=logger,
    )

    backup_path: Path | None = None

    if path_exists(target):
        if backup_root is not None:
            backup_path = backup_existing_target(
                target,
                backup_root,
                requires_sudo=requires_sudo,
                options=options,
                logger=logger,
                reserved_paths=reserved_backups,
            )
        else:
            logger.warning(f"Replacing without backup: {target}")
            if requires_sudo:
                run_sudo(["rm", "-rf", "--", str(target)], options, logger)
            else:
                remove_path(target, options, logger)

    label = "Link (system)" if requires_sudo else "Link"
    logger.info(f"{label}: {source} -> {target}")

    try:
        if options.dry_run:
            return

        if requires_sudo:
            run_sudo(
                ["ln", "-sfnT", "--", str(source), str(target)],
                options,
                logger,
            )
        else:
            target.symlink_to(source)
    except Exception:
        restore_backup(
            backup_path,
            target,
            requires_sudo=requires_sudo,
            options=options,
            logger=logger,
        )
        raise


# =============================================================================
# DESKTOP CONFIGURATION
# =============================================================================

def build_user_config_mappings() -> list[SymlinkTarget]:
    mappings = list(USER_CONFIG_MAPPINGS)

    if IS_WSL_ENVIRONMENT or not ACTIVE_DESKTOP_ENV:
        return mappings

    config_name = DESKTOP_CONFIG_NAMES.get(ACTIVE_DESKTOP_ENV, ACTIVE_DESKTOP_ENV)
    mappings.append(
        SymlinkTarget(
            config_name,
            USER_HOME_DIR / ".config" / config_name,
            is_gui_only=True,
        )
    )
    return mappings


# =============================================================================
# PROCESSING
# =============================================================================

def process_mapping(
    entry: SymlinkTarget,
    backup_root: Path | None,
    reserved_backups: set[Path],
    options: RuntimeOptions,
    logger: Logger,
) -> MappingResult:
    if IS_WSL_ENVIRONMENT and entry.is_gui_only:
        logger.info(f"Skipping (WSL): {entry.source_relative_path}")
        return "skipped"

    if not entry.target_absolute_path.is_absolute():
        logger.error(f"Target must be an absolute path: {entry.target_absolute_path}")
        return "failed"

    source_path = DOTFILES_DIR_PATH / entry.source_relative_path
    if not source_path.exists():
        logger.warning(f"Skipping (source not found): {source_path}")
        return "skipped"

    try:
        source = source_path.resolve(strict=True)
        target = entry.target_absolute_path

        if paths_are_same_symlink(target, source):
            logger.success(f"Already linked: {target} -> {source}")
            return "success"

        process_symlink(
            source,
            target,
            backup_root,
            reserved_backups,
            requires_sudo=entry.requires_sudo,
            options=options,
            logger=logger,
        )
        return "success"

    except subprocess.CalledProcessError as exc:
        logger.error(f"Command failed for {entry.target_absolute_path}: exit code {exc.returncode}")
    except PermissionError as exc:
        logger.error(f"Permission denied for {entry.target_absolute_path}: {exc}")
    except (OSError, RuntimeError, ValueError) as exc:
        logger.error(f"Could not process {entry.target_absolute_path}: {exc}")

    return "failed"


def preflight_sudo(
    mappings: list[SymlinkTarget],
    options: RuntimeOptions,
    logger: Logger,
) -> bool:
    needs_sudo = any(
        entry.requires_sudo
        and not (IS_WSL_ENVIRONMENT and entry.is_gui_only)
        and (DOTFILES_DIR_PATH / entry.source_relative_path).exists()
        for entry in mappings
    )

    if not needs_sudo or options.dry_run:
        return True
    if shutil.which("sudo") is None:
        logger.error("Required command not found: sudo")
        return False

    try:
        subprocess.run(["sudo", "-v"], check=True)
    except subprocess.CalledProcessError as exc:
        logger.error(f"Could not authenticate with sudo: exit code {exc.returncode}")
        return False

    return True


# =============================================================================
# CLI / MAIN
# =============================================================================

def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Safely install dotfiles using symbolic links.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Show planned changes without modifying the filesystem.",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        help="Enable verbose/debug output.",
    )
    parser.add_argument(
        "--no-backup",
        action="store_true",
        help="Replace existing targets without creating backups.",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_arguments()
    options = RuntimeOptions(
        dry_run=args.dry_run,
        verbose=args.verbose,
        backup=not args.no_backup,
    )
    logger = Logger(options.verbose)

    print("\n=== Dotfiles Symlink Setup ===\n")
    logger.info(f"Dotfiles directory: {DOTFILES_DIR_PATH}")

    if IS_WSL_ENVIRONMENT:
        logger.info("Environment: WSL (GUI targets will be skipped)")
    elif ACTIVE_DESKTOP_ENV:
        logger.info(f"Desktop environment: {ACTIVE_DESKTOP_ENV}")
    else:
        logger.info("Desktop environment: not detected")

    if options.dry_run:
        logger.warning("DRY RUN: no filesystem changes will be made.")
    if not options.backup:
        logger.warning("Backup disabled; existing targets will be replaced permanently.")

    if not DOTFILES_DIR_PATH.is_dir():
        logger.error(f"Dotfiles directory does not exist or is not a directory: {DOTFILES_DIR_PATH}")
        return 1
    if os.geteuid() == 0:
        logger.error("Do not run this script as root. Run it as your normal user.")
        return 1

    user_mappings = build_user_config_mappings()
    if not preflight_sudo(SYSTEM_CONFIG_MAPPINGS, options, logger):
        return 1

    backup_root = None
    if options.backup:
        timestamp = datetime.now().strftime("%Y-%m-%d_%H%M%S")
        backup_root = USER_HOME_DIR / BACKUP_DIR_NAME / timestamp

    reserved_backups: set[Path] = set()
    counts = {"total": 0, "success": 0, "skipped": 0, "failed": 0}

    for group_name, mappings in (
        ("user configurations", user_mappings),
        ("system configurations", SYSTEM_CONFIG_MAPPINGS),
    ):
        logger.info(f"Processing {group_name}...")

        for entry in mappings:
            counts["total"] += 1
            result = process_mapping(
                entry,
                backup_root,
                reserved_backups,
                options,
                logger,
            )
            counts["success" if result == "success" else result] += 1

    print("\n=== Summary ===")
    print(f"Total:      {counts['total']}")
    print(f"Successful: {counts['success']}")
    print(f"Skipped:    {counts['skipped']}")
    print(f"Failed:     {counts['failed']}")

    if backup_root is not None and reserved_backups:
        print(f"Backups:    {backup_root}")
    if options.dry_run:
        print("\nDry-run complete. No changes were made.")

    print()
    return 1 if counts["failed"] else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\n[WARN] Interrupted by user.", file=sys.stderr)
        sys.exit(130)
    except Exception as exc:
        print(f"[ERROR] Unexpected failure: {exc}", file=sys.stderr)
        sys.exit(1)
