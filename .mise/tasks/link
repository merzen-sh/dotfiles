#!/usr/bin/env python3
import os
import shutil
import subprocess
from dataclasses import dataclass
from pathlib import Path


def is_wsl_environment() -> bool:
    """Check if the execution environment is WSL."""
    proc_version = Path("/proc/version")
    if proc_version.exists():
        try:
            return "microsoft" in proc_version.read_text().lower()
        except OSError:
            pass
    return False


IS_WSL_ENVIRONMENT = is_wsl_environment()
# Read Desktop environment from Environment Variables (defaults to XDG_CURRENT_DESKTOP)
ACTIVE_DESKTOP_ENV = os.environ.get(
    "DOTFILES_DESKTOP", os.environ.get("XDG_CURRENT_DESKTOP", "")
).lower()

DOTFILES_DIR_PATH = Path(
    os.environ.get("DOTFILES_DIR", Path.cwd())
).resolve()
USER_HOME_DIR = Path.home()


@dataclass(frozen=True)
class SymlinkTarget:
    source_relative_path: str
    target_absolute_path: Path
    is_gui_only: bool = False
    requires_sudo: bool = False


# 1. Base User Configurations (Runs across all environments)
USER_CONFIG_MAPPINGS = [
    SymlinkTarget(".tmux.conf", USER_HOME_DIR / ".tmux.conf"),
    SymlinkTarget(".vimrc", USER_HOME_DIR / ".vimrc"),
    SymlinkTarget("starship.toml", USER_HOME_DIR / ".config" / "starship.toml"),
    SymlinkTarget("fish", USER_HOME_DIR / ".config" / "fish"),
    SymlinkTarget("fastfetch", USER_HOME_DIR / ".config" / "fastfetch"),
    SymlinkTarget("nvim", USER_HOME_DIR / ".config" / "nvim"),
    SymlinkTarget("fzf", USER_HOME_DIR / ".config" / "fzf"),
    # General GUI Tools
    SymlinkTarget(
        "ghostty", USER_HOME_DIR / ".config" / "ghostty", is_gui_only=True
    ),
    SymlinkTarget(
        "kitty", USER_HOME_DIR / ".config" / "kitty", is_gui_only=True
    ),
    SymlinkTarget(
        "noctalia",
        USER_HOME_DIR / ".local" / "state" / "noctalia",
        is_gui_only=True,
    ),
]

# 2. Dynamic Desktop Environment Mapping
# Automatically maps folder if ENV is set (e.g., DOTFILES_DESKTOP=hyprland or niri)
if ACTIVE_DESKTOP_ENV and not IS_WSL_ENVIRONMENT:
    USER_CONFIG_MAPPINGS.append(
        SymlinkTarget(
            source_relative_path=ACTIVE_DESKTOP_ENV,
            target_absolute_path=USER_HOME_DIR
            / ".config"
            / ACTIVE_DESKTOP_ENV,
            is_gui_only=True,
        )
    )

# 3. System-level Configuration Mappings
SYSTEM_CONFIG_MAPPINGS = [
    SymlinkTarget(
        source_relative_path="etc/keyd/default.conf",
        target_absolute_path=Path("/etc/keyd/default.conf"),
        is_gui_only=True,
        requires_sudo=True,
    ),
]


def process_user_symlink(
    source_absolute_path: Path, target_absolute_path: Path
) -> None:
    """Safely create symlink for user space targets."""
    target_absolute_path.parent.mkdir(parents=True, exist_ok=True)

    if target_absolute_path.is_symlink():
        try:
            if (
                target_absolute_path.readlink().resolve()
                == source_absolute_path
            ):
                print(
                    f"Already linked: {target_absolute_path} -> {source_absolute_path}"
                )
                return
        except OSError:
            pass

    if target_absolute_path.is_symlink() or target_absolute_path.is_file():
        target_absolute_path.unlink()
    elif target_absolute_path.is_dir():
        shutil.rmtree(target_absolute_path)

    target_absolute_path.symlink_to(source_absolute_path)
    print(f"Linked: {source_absolute_path} -> {target_absolute_path}")


def process_system_symlink(
    source_absolute_path: Path, target_absolute_path: Path
) -> None:
    """Create symlink for system targets requiring elevated root privileges."""
    target_absolute_path.parent.mkdir(parents=True, exist_ok=True)

    if target_absolute_path.is_symlink():
        try:
            if (
                target_absolute_path.readlink().resolve()
                == source_absolute_path
            ):
                print(
                    f"Already linked: {target_absolute_path} -> {source_absolute_path}"
                )
                return
        except OSError:
            pass

    subprocess.run(
        ["sudo", "mkdir", "-p", str(target_absolute_path.parent)], check=True
    )
    subprocess.run(
        [
            "sudo",
            "ln",
            "-sfn",
            str(source_absolute_path),
            str(target_absolute_path),
        ],
        check=True,
    )
    print(f"Linked (System): {source_absolute_path} -> {target_absolute_path}")


def main() -> None:
    print("=== Running Symlink Setup ===")
    if IS_WSL_ENVIRONMENT:
        print("Environment: WSL (GUI targets will be skipped)")
    elif ACTIVE_DESKTOP_ENV:
        print(f"Active Desktop ENV: {ACTIVE_DESKTOP_ENV}")

    # Process User Configs
    for entry in USER_CONFIG_MAPPINGS:
        if IS_WSL_ENVIRONMENT and entry.is_gui_only:
            print(f"Skipping (WSL): {entry.source_relative_path}")
            continue

        source_abs_path = (
            DOTFILES_DIR_PATH / entry.source_relative_path
        ).resolve()
        if not source_abs_path.exists():
            print(f"Skipping (Not Found): {source_abs_path}")
            continue

        process_user_symlink(source_abs_path, entry.target_absolute_path)

    # Process System Configs
    for entry in SYSTEM_CONFIG_MAPPINGS:
        if IS_WSL_ENVIRONMENT and entry.is_gui_only:
            print(
                f"Skipping System Task (WSL): {entry.source_relative_path}"
            )
            continue

        source_abs_path = (
            DOTFILES_DIR_PATH / entry.source_relative_path
        ).resolve()
        if not source_abs_path.exists():
            print(f"Skipping System Task (Not Found): {source_abs_path}")
            continue

        process_system_symlink(source_abs_path, entry.target_absolute_path)


if __name__ == "__main__":
    main()