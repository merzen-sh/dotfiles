{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "os": "#FFFFFF",
    "session": "cyan",
    "path": "#E6E6E6",
    "git": "cyan",
    "rust": "#DEA584",
    "bun": "#FBF0DF",
    "pnpm": "#F69220",
    "go": "#7BDFF2",
    "python": "#FFC799",
    "closer": "#FFFFFF"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:os",
          "style": "plain",
          "template": "󰣇 ",
          "type": "os"
        },
        {
          "foreground": "p:session",
          "style": "plain",
          "template": "{{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "foreground": "p:path",
          "properties": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short"
          },
          "style": "plain",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "p:git",
          "properties": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "template": "{{ .HEAD }} ",
          "style": "plain",
          "type": "git"
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "p:rust",
          "template": "\ue7a8 {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "cache_duration": "10m"
          }
        },
        {
          "type": "bun",
          "style": "plain",
          "foreground": "p:bun",
          "template": "\ue76f {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "cache_duration": "10m"
          }
        },
        {
          "type": "pnpm",
          "style": "plain",
          "foreground": "p:pnpm",
          "template": "\ue865 {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "cache_duration": "10m"
          }
        },
        {
          "type": "go",
          "style": "plain",
          "foreground": "p:go",
          "template": "\udb81\udfd3 {{ .Full }} ",
          "properties": {
            "fetch_version": true,
            "display_mode": "files",
            "cache_duration": "10m"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "p:python",
          "template": "\uE235 {{ .Venv }} ",
          "properties": {
            "display_mode": "environment",
            "fetch_virtual_env": true
          }
        },
        {
          "style": "plain",
          "foreground": "p:closer",
          "template": "\uf105",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
