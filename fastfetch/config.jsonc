{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch-ascii.txt",
        "color": {
            "1": "cyan"
        }
    },
    "display": {
        "separator": ": ",
    },
    "modules": [
        {
            "type": "os",
            "key": "󰣇 OS",
            "keycolor": "cyan",
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "cyan",
        },
        {
            "type": "packages",
            "key": " Packages",
            "keyColor": "cyan",  
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "cyan", 
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "cyan", 
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "cyan", 
        },
        {
            "type": "terminalfont",
            "key": " Font",
            "keyColor": "cyan", 
        },
        {
            "type": "uptime",
            "key": " Uptime",
            "keyColor": "cyan", 
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "cyan"
        },
        {
            "type": "monitor",
            "key": " Monitor",
            "keyColor": "cyan",
        },
    ]
}
