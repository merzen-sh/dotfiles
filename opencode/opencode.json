{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
    },
    "obscura": {
      "type": "local",
      "command": ["obscura", "mcp", "--stealth"]
    },
    "webmcp": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@jason.today/webmcp@latest",
        "--mcp"
      ]
    }
  }
}
